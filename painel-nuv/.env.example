# Senha de acesso ao painel (só você usa)
APP_PASSWORD=troque-esta-senha
# Texto aleatório longo, usado para assinar o cookie de login
AUTH_SECRET=gere-um-texto-aleatorio-com-40-caracteres

# Notion: crie uma integração em https://www.notion.so/my-integrations
# e conecte a página NUVDash a ela (••• > Conexões)
NOTION_TOKEN=ntn_xxx

# Supabase (Settings > API): URL do projeto e a chave service_role (secreta, só no servidor)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxx

# Claude API (lê os prints/PDF de métricas): https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-xxx
