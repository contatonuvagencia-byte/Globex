# Senha da administração (você). No login, deixe o e-mail em branco e use esta senha.
# A equipe entra com e-mail e senha próprios, cadastrados na aba Equipe.
APP_PASSWORD=troque-esta-senha
# Opcional: seu nome na saudação e um e-mail para entrar como administração
# ADMIN_NOME=Isabela
# ADMIN_EMAIL=contato@suaagencia.com
# Texto aleatório longo, usado para assinar o cookie de login
AUTH_SECRET=gere-um-texto-aleatorio-com-40-caracteres

# Notion: crie uma integração em https://www.notion.so/my-integrations
# com as capacidades "Ler conteúdo", "Atualizar conteúdo" e "Inserir conteúdo"
# e conecte a página NUVDash a ela (••• > Conexões)
NOTION_TOKEN=ntn_xxx
# Opcional: ID do banco CLIENTES do Notion (usado para achar calendários de clientes novos)
# NOTION_CLIENTES_DB=28d07ce018a781c98e19d6a5c8a60f1b
# Opcional: ID do banco "Minha Semana Produtiva - NUV" (aba Demandas)
# NOTION_DEMANDAS_DB=1d207ce018a78071a1c0f17e172c1c76

# Supabase (Settings > API): URL do projeto e a chave service_role (secreta, só no servidor)
SUPABASE_URL=https://goxtzswosdtmfpblergv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxx

# OPCIONAL e PAGO. Sem ela, tudo funciona de graça: você usa o seu Claude (claude.ai)
# copiando e colando. Com ela, o painel lê os prints e escreve as mensagens sozinho.
# ANTHROPIC_API_KEY=sk-ant-xxx
